---
import Base from '../layouts/Base.astro';
import { CONTACT } from '../data/index';
---

<Base
  title="About — Divit Tasgaonkar"
  description="I'm Divit. I'm a developer based in Mumbai. I make games and small tools."
>
  <div class="page-content" style="padding-top: var(--s-8); padding-bottom: var(--s-9);">
    <!-- Header -->
    <div class="section-header section-grid">
      <span class="slate-label">05 — ABOUT</span>
      <div>
        <span class="coord-faint" style="display: block; margin-bottom: 6px;">Personal record</span>
        <h1>A short biography</h1>
      </div>
    </div>

    <!-- Body -->
    <div class="section-grid about-body-grid">
      <div></div>

      <div class="about-bio">
        <p class="bio-lead">
          I'm Divit. I'm a developer based in Mumbai. I make games and small tools, and I write devlogs about both.
          I am most useful in the messy middle of a project, when an idea has shape but no edges yet.
        </p>
        <p>
          Right now I'm building <a href="/devlog" class="helios-link">Catastrophe Cafe</a> — a chaotic
          co-op cat-cafe game — with friends. Before that I shipped <span class="star-text">Agneepath</span>,
          a 2D platformer, in roughly twenty-four hours.
        </p>
        <p>
          I read a lot of science fiction (Star Wars is the comfort food; Le Guin is the broccoli), make
          tea that is barely tea, and I am not great at LinkedIn — but I am there.
        </p>
        <p>
          If you want to make something together, or you just want to talk about cats and netcode,
          <a href={`mailto:${CONTACT.email}`}>send a transmission</a>.
        </p>
      </div>

      <div class="about-sidebar">
        <!-- Currently -->
        <div class="sidebar-card">
          <span class="coord-faint" style="display: block; margin-bottom: 10px;">CURRENTLY · 2026.05</span>
          <ul class="currently-list">
            <li>· Building Catastrophe Cafe v0.4</li>
            <li>· Replaying KOTOR (still)</li>
            <li>· Open to interesting collaborations</li>
          </ul>
          <div class="card-rule">
            <span class="pill-transmit">
              <span class="pulse-dot pulse-dot--plasma" aria-hidden="true"></span>
              Open to work
            </span>
          </div>
        </div>

        <!-- Contact -->
        <div class="sidebar-card" style="margin-top: 18px;">
          <span class="coord-faint" style="display: block; margin-bottom: 10px;">SIGNAL · CONTACT</span>
          <div class="contact-links">
            <a href={`mailto:${CONTACT.email}`} class="contact-link">
              <span class="contact-label">Email</span>
              <span class="contact-value">{CONTACT.email}</span>
              <span class="contact-arrow">↗</span>
            </a>
            <a href={CONTACT.github.url} target="_blank" rel="noreferrer" class="contact-link">
              <span class="contact-label">GitHub</span>
              <span class="contact-value">github.com/{CONTACT.github.handle}</span>
              <span class="contact-arrow">↗</span>
            </a>
            <a href={CONTACT.linkedin.url} target="_blank" rel="noreferrer" class="contact-link">
              <span class="contact-label">LinkedIn</span>
              <span class="contact-value">/in/{CONTACT.linkedin.handle}</span>
              <span class="contact-arrow">↗</span>
            </a>
          </div>
          <div class="card-rule">
            <span class="coord-faint">Response window · 1–3 sols</span>
          </div>
        </div>

        <!-- Coordinates -->
        <div class="sidebar-card" style="margin-top: 18px;">
          <span class="coord-faint" style="display: block; margin-bottom: 10px;">COORDINATES</span>
          <div class="coords-block">
            MUMBAI · IN<br />
            LAT 19.0760°N<br />
            LON 72.8777°E<br />
            TZ  UTC+05:30
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .section-grid {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    align-items: baseline;
  }

  .about-body-grid {
    display: grid;
    grid-template-columns: 120px 1fr 360px;
    gap: 24px;
    align-items: start;
  }

  .section-header {
    margin-bottom: 40px;
  }

  .section-header h1 {
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--star);
  }

  .slate-label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--star-mute);
    padding-top: 4px;
  }

  .coord-faint {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--star-faint);
  }

  .about-bio {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .bio-lead {
    font-size: 18px;
    line-height: 1.7;
    color: var(--star);
  }

  .about-bio p {
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--star-dim);
  }

  .about-bio a {
    color: var(--helios);
  }

  .helios-link { color: var(--helios); }
  .star-text { color: var(--star); }

  .sidebar-card {
    border: var(--border-hair);
    border-radius: var(--r-md);
    padding: 18px;
    background: var(--deep-space);
  }

  .currently-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--star-dim);
    list-style: none;
  }

  .card-rule {
    margin-top: 14px;
    padding-top: 14px;
    border-top: var(--border-dash);
  }

  .pill-transmit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--r-full);
    border: var(--border-hair);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--star);
    white-space: nowrap;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    animation: divit-pulse 1.6s infinite;
    flex-shrink: 0;
  }
  .pulse-dot--plasma { background: var(--plasma); }

  .contact-links {
    display: flex;
    flex-direction: column;
  }

  .contact-link {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    align-items: baseline;
    gap: 10px;
    padding: 8px 0;
    border-bottom: var(--border-dot);
    text-decoration: none;
    border-top: none;
    border-left: none;
    border-right: none;
    font-family: var(--font-mono);
    font-size: 13px;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .contact-link:hover { opacity: 0.8; }
  .contact-link:last-child { border-bottom: none; }

  .contact-label {
    color: var(--star-faint);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-value {
    color: var(--star);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-arrow {
    color: var(--helios);
  }

  .coords-block {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--star-mute);
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .about-body-grid {
      grid-template-columns: 120px 1fr;
    }
    .about-sidebar {
      grid-column: 2;
      grid-row: 2;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .about-sidebar .sidebar-card { margin-top: 0 !important; }
  }

  @media (max-width: 640px) {
    .section-grid, .about-body-grid { grid-template-columns: 1fr; }
    .slate-label { display: none; }
    .about-sidebar { grid-template-columns: 1fr; }
  }
</style>
