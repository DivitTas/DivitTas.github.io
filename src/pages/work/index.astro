---
import Base from '../../layouts/Base.astro';
import WorkFilter from '../../components/WorkFilter';
import { PROJECTS } from '../../data/index';
---

<Base
  title="Work — Divit Tasgaonkar"
  description="Everything I'll admit to. Games, tools, shipped and in progress."
>
  <div class="page-content" style="padding-top: var(--s-8); padding-bottom: var(--s-9);">
    <div class="section-header">
      <div class="section-grid">
        <span class="slate-label">02 — WORK</span>
        <div>
          <span class="coord-faint" style="display: block; margin-bottom: 6px;">
            Complete index · {PROJECTS.length} entries
          </span>
          <h1>Everything I'll admit to</h1>
        </div>
      </div>
    </div>

    <WorkFilter projects={PROJECTS} client:load />
  </div>
</Base>

<style>
  .section-grid {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    align-items: baseline;
  }

  .section-header {
    margin-bottom: 40px;
  }

  h1 {
    font-size: var(--fs-h1);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--star);
  }

  .slate-label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--star-mute);
    padding-top: 4px;
  }

  .coord-faint {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--star-faint);
  }

  @media (max-width: 640px) {
    .section-grid { grid-template-columns: 1fr; }
    .slate-label { display: none; }
  }
</style>
